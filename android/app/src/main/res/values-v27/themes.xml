<?xml version="1.0" encoding="utf-8"?>
<!-- Same dark theme as values/themes.xml, plus the light-navigation-bar switch that
     only exists from API 27. Kept in its own version folder so API 24-26 never reads
     an attribute their framework does not know. -->
<resources>

    <style name="Theme.NodePulse" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/np_background</item>
        <item name="android:statusBarColor">@color/np_background</item>
        <item name="android:navigationBarColor">@color/np_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:colorAccent">#38bdf8</item>
    </style>

</resources>
